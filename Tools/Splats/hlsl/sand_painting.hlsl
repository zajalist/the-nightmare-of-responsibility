// Existing painting image; only its separate canvas moves, never the frame.
float2 q = saturate(UV);
float age = max(0.0, Clock - Pulse);
float pulse = (age < 4.0 && Pulse > 0.0) ? sin(age * 0.785398) : 0.0;
float amount = saturate(Stage / 5.0);
float movement = (amount * 0.012 + pulse * 0.045) * (1.0 - saturate(ReduceMotion));
float column = floor(q.x * 70.0);
float seed = frac(sin(column * 127.1) * 43758.5453);
float2 displaced = q;
displaced.y += movement * sin(Clock * (0.45 + seed) + column * 0.61);
displaced.x += movement * 0.35 * sin(q.y * 23.0 + Clock * 0.6);
float2 atlas = saturate(displaced);
float3 picture = Texture2DSample(Art, ArtSampler, atlas).rgb;
float dark = 1.0 - dot(picture, float3(0.2126,0.7152,0.0722));
float2 flow = float2(q.x * 155.0, q.y * 190.0 + Clock * (2.0 + amount * 4.0 + seed * 2.0) * (1.0 - saturate(ReduceMotion)));
float2 cell = floor(flow);
float grainSeed = frac(sin(dot(cell,float2(127.1,311.7))) * 43758.5453);
float seed2 = frac(sin(dot(cell,float2(269.5,183.3))) * 43758.5453);
float2 centre = float2(0.12 + grainSeed * 0.76,0.12 + seed2 * 0.76);
float radius = 0.09 + seed2 * 0.25;
float grain = 1.0 - smoothstep(radius,radius+0.07,length(frac(flow)-centre));
float density = saturate(0.18 + dark * 0.75 + pulse * 0.2);
float ink = grain * step(grainSeed, density);
float3 sandPicture = lerp(picture * 0.86 + 0.018, float3(0.006,0.006,0.006), ink);
float settling = smoothstep(0.82 - amount * 0.3, 1.0, q.y + 0.045*sin(q.x*19.0+Clock*.3));
sandPicture = lerp(sandPicture,float3(0.008,0.008,0.008),settling * amount * 0.62);
float3 result = lerp(picture,sandPicture,saturate(amount * 0.8 + pulse * 0.9));
float edge = min(min(q.x,1.0-q.x),min(q.y,1.0-q.y));
return float4(result,smoothstep(0.0,0.012,edge));
